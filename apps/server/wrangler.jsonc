{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asobo",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		// The built SvelteKit app. Run `pnpm build` at the repo root first.
		"directory": "../web/build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Only these paths reach the Worker; everything else is served as a static file.
		"run_worker_first": ["/api/*"]
	}
}
